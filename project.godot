; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Wintervale Station"
config/description="Cozy Railway Village – ein gemütliches Low-Poly Eisenbahn- und Dorfbau-Spiel."
config/version="0.1.0"
run/main_scene="res://scenes/ui/main_menu.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://assets/ui/icon.png"

[autoload]

Events="*res://systems/events.gd"
GameSettings="*res://systems/game_settings.gd"
GameInput="*res://systems/game_input.gd"
WorldClock="*res://systems/world_clock.gd"
SaveManager="*res://systems/save_manager.gd"
Economy="*res://systems/economy.gd"
Seasons="*res://systems/seasons.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[layer_names]

3d_physics/layer_1="Welt"
3d_physics/layer_2="Spieler"
3d_physics/layer_3="Objekte"
3d_physics/layer_4="Gleise"
3d_physics/layer_5="Natur"
3d_physics/layer_6="Züge"
3d_physics/layer_7="Bewohner"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

anti_aliasing/quality/msaa_3d=2

[shader_globals]

snow_cover={
"type": "float",
"value": 1.0
}
season_grass={
"type": "color",
"value": Color(0.42, 0.52, 0.3, 1)
}
season_bare={
"type": "color",
"value": Color(0.47, 0.44, 0.4, 1)
}
foliage_autumn={
"type": "float",
"value": 0.0
}
foliage_spring={
"type": "float",
"value": 0.0
}
wind_strength={
"type": "float",
"value": 0.35
}
wetness={
"type": "float",
"value": 0.0
}
